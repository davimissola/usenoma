# URL PostgreSQL do projeto Supabase, obtida em Connect.
DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres?sslmode=require

# Gere uma chave aleatória com pelo menos 32 bytes. Não use uma chave de exemplo.
SECRET_KEY=

FRONTEND_URL=http://localhost:5173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# false apenas no desenvolvimento local com HTTP; true em produção com HTTPS.
COOKIE_SECURE=false
